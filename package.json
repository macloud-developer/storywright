{
  "name": "storywright-monorepo",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "test": "vp test run",
    "test:watch": "vp test",
    "lint": "vp check",
    "lint:fix": "vp check --fix",
    "typecheck": "pnpm -r run typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version && vp fmt",
    "ci:publish": "pnpm publish -r --no-git-checks",
    "prepare": "vp config",
    "seed-report": "pnpm --filter @storywright/report seed-report",
    "dev:report": "pnpm --filter @storywright/report dev"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "typescript": "^6.0.3",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@12.15.0"
}
